# ═══════════════════════════════════════════════════════════
# Portfolio Backend Environment Configuration
# ═══════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────
# DATABASE CONFIGURATION
# ───────────────────────────────────────────────────────────
# 
# Local Development (SQLite):
# - Leave DATABASE_URL empty or commented out
# - SQLite file will be created at: backend/portfolio.db
# 
# Production (PostgreSQL on Render):
# - Render sets this automatically from render.yaml
# - Format: postgres://user:password@host:5432/database
#
# DATABASE_URL=

# ───────────────────────────────────────────────────────────
# ADMIN CREDENTIALS
# ───────────────────────────────────────────────────────────
# Used for admin panel login
# Change these before deploying to production!
#
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-secure-password

# ───────────────────────────────────────────────────────────
# SMTP CONFIGURATION (Contact Form Emails)
# ───────────────────────────────────────────────────────────
#
# For Gmail:
# 1. Go to https://myaccount.google.com/apppasswords
# 2. Sign in with your Google account
# 3. Create app password for "Mail"
# 4. Copy the 16-character password
# 5. Use it as SMTP_PASSWORD below
#
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password

# ───────────────────────────────────────────────────────────
# CORS ORIGINS
# ───────────────────────────────────────────────────────────
# Allowed frontend URLs (JSON array format)
#
# Local Development:
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
#
# Production (update after deploying frontend):
# CORS_ORIGINS=["https://your-app.vercel.app"]

# ───────────────────────────────────────────────────────────
# FILE STORAGE
# ───────────────────────────────────────────────────────────
# 
# Local Development:
# - Leave empty, uses backend/uploads/
#
# Production (Render):
# - Set to /data (persistent disk mount path)
#
# DATA_DIR=/data

# ───────────────────────────────────────────────────────────
# PYTHON VERSION
# ───────────────────────────────────────────────────────────
# Used by Render for deployment
PYTHON_VERSION=3.11.9

# ═══════════════════════════════════════════════════════════
# DEPLOYMENT NOTES
# ═══════════════════════════════════════════════════════════
#
# For Render Deployment:
# 1. Don't commit this file with real credentials!
# 2. Set environment variables in Render dashboard
# 3. DATABASE_URL is auto-set from render.yaml
# 4. DATA_DIR should be /data (persistent disk)
# 5. Update CORS_ORIGINS after deploying frontend
#
# For Local Development:
# 1. Copy this file to .env
# 2. Update credentials
# 3. Leave DATABASE_URL empty (uses SQLite)
# 4. Leave DATA_DIR empty (uses backend/uploads/)
#
# ═══════════════════════════════════════════════════════════
